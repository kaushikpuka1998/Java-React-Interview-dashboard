{
	admin off
}

:{$PORT:80}

root * dist

encode gzip zstd

# Explicit MIME types to satisfy strict module script MIME checking in browsers.
@js path *.js
header @js Content-Type "application/javascript; charset=utf-8"

@css path *.css
header @css Content-Type "text/css; charset=utf-8"

# Long-lived, immutable caching for hashed/versioned build assets.
@assets path /assets/*
header @assets Cache-Control "public, max-age=31536000, immutable"

# Never cache the HTML shell so clients always pick up new asset hashes.
@html path *.html
header @html Cache-Control "no-cache, no-store, must-revalidate"

file_server

try_files {path} /index.html
