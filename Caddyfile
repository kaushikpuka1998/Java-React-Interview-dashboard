{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Permanent (301) redirect from the Railway-provided domain to the custom domain.
	# The service worker script is the one exception: browsers refuse a redirected worker script, so
	# a visitor who installed the app on the Railway address would keep running the old cached copy
	# (which never reaches this redirect). Instead that address gets a worker that removes itself,
	# wipes the caches and sends every open tab to the custom domain.
	@railwayDomain {
		host interviewreader.up.railway.app
		not path /sw.js
	}
	redir @railwayDomain https://interviewreader.cloud{uri} permanent

	@railwayWorker {
		host interviewreader.up.railway.app
		path /sw.js
	}
	header @railwayWorker Content-Type "application/javascript; charset=utf-8"
	header @railwayWorker Cache-Control "no-store"
	respond @railwayWorker <<JS
		self.addEventListener('install', () => self.skipWaiting());
		self.addEventListener('activate', event => event.waitUntil((async () => {
		  for (const key of await caches.keys()) await caches.delete(key);
		  await self.registration.unregister();
		  for (const client of await self.clients.matchAll({ type: 'window' })) {
		    const url = new URL(client.url);
		    client.navigate('https://interviewreader.cloud' + url.pathname + url.search + url.hash);
		  }
		})()));
		JS 200

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	root * /app/dist

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# SPA routing
	try_files {path} {path}.html {path}/index.html /index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
